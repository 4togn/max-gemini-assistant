# Токен Gemini API (получите бесплатно на https://aistudio.google.com/)                                                                        
GEMINI_API_KEY=your_gemini_api_key_here                                                                                                        
                                                                                                                                                   
# Модели Gemini по приоритету каскада:                                                                                                         
# GEMINI_MODEL_1 — ОСНОВНАЯ модель (ОБЯЗАТЕЛЬНА: если не заполнена, бот не запустится).                                                        
# К основной модели делается 3 попытки, после чего бот переключается к резервным.                                                              
GEMINI_MODEL_1=gemini-3.8-flash                                                                                                                
                                                                                                                                          
# Резервные модели (ОПЦИОНАЛЬНО: если переменная пустая, попытка пропускается и бот идет дальше):                                              
# Если GEMINI_MODEL_2 пустая -> переходит к GEMINI_MODEL_3 -> затем к GEMINI_MODEL_4.                                                          
# (При необходимости можно добавлять GEMINI_MODEL_5, GEMINI_MODEL_6 и т.д.)                                                                    
# Если все модели исчерпали квоту (429) или недоступны -> бот пришлет карточку с понятной ошибкой в чат.                                       
GEMINI_MODEL_2=gemini-3.7-flash
GEMINI_MODEL_3=gemini-3.6-flash
GEMINI_MODEL_4=gemini-3.5-flash
  
# Название чата для мониторинга в web.max.ru (по умолчанию "Избранное")
MAX_CHAT_NAME=Избранное
  
# Режим запуска браузера (по умолчанию true — невидимый headless-режим)
# Если вход по СМС еще не выполнен, скрипт на ПК с экраном сам откроет видимое окно
HEADLESS=true
  
# Тема оформления карточек WebP (dark или light)
CARD_THEME=dark
  
    # Ширина карточки в пикселях (оптимально для экранов смартфонов)
    CARD_WIDTH=760
  
    # Путь для сохранения сессии и профиля браузера
    USER_DATA_DIR=./user_data
