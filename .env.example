# Токен Gemini API (получите бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini
GEMINI_MODEL=gemini-3.8-flash

# Название чата для мониторинга в web.max.ru (по умолчанию "Избранное")
MAX_CHAT_NAME=Избранное

# Режим запуска браузера (по умолчанию true — невидимый)
# Если вход еще не выполнен, бот сам откроет видимое окно для СМС на ПК с экраном
HEADLESS=true

# Тема оформления карточек WebP (dark или light)
CARD_THEME=dark

# Ширина карточки в пикселях (оптимально для экранов смартфонов)
CARD_WIDTH=760

# Путь для сохранения сессии браузера
USER_DATA_DIR=./user_data
